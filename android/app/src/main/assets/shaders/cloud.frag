#version 300 es
precision highp float;
in vec2 vUv;out vec4 color;uniform mat4 uInverse;uniform vec3 uEye,uFocus;uniform sampler2D uNoise;uniform float uTime,uNear,uEnergy,uGlow,uSelected;
float volumeNoise(vec3 p){vec3 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);vec2 uv=i.xy+vec2(37.,17.)*i.z+f.xy;return mix(texture(uNoise,(uv+.5)/128.).r,texture(uNoise,(uv+vec2(37.,17.)+.5)/128.).r,f.z);}
float field(vec3 p){vec3 q=p+vec3(sin(p.y*.24+uTime*.12),cos(p.z*.22-uTime*.1),sin(p.x*.23+uTime*.08))*1.5;vec3 drift=vec3(uTime*.018,-uTime*.012,uTime*.016);float n=volumeNoise(q*.17+drift)*.56+volumeNoise(q*.39-drift)*.29+volumeNoise(q*.84+drift)*.15;vec3 radii=mix(vec3(18.,10.,11.),vec3(33.,22.,26.),uNear);float r=length(q/radii)+(.5-n)*.38;float body=1.-smoothstep(.48,1.03,r);float shell=exp(-pow((r-.67)*6.,2.));float voids=smoothstep(.5,.82,volumeNoise(q*.1-drift));float billow=smoothstep(.38,.69,n);float folds=pow(1.-abs(n-.52)*2.,14.);return(body*billow*.72+shell*folds*.22)*(1.-voids*.92);}
void main(){vec4 end=uInverse*vec4(vUv*2.-1.,1.,1.);vec3 ray=normalize(end.xyz/end.w-uEye);vec3 bounds=mix(vec3(20.,12.,13.),vec3(38.,26.,30.),uNear);vec3 o=uEye/bounds,d=ray/bounds;float a=dot(d,d),b=dot(o,d),c=dot(o,o)-1.,h=b*b-a*c;if(h<0.){color=vec4(.001,.003,.009,1.);return;}h=sqrt(h);float start=max(0.,(-b-h)/a),finish=(-b+h)/a,stepSize=(finish-start)/20.,transmission=1.;vec3 light=vec3(0.);float focusRay=pow(max(0.,dot(ray,normalize(uFocus-uEye))),36.)*uSelected;
for(int i=0;i<20;i++){vec3 p=uEye+ray*(start+(float(i)+.5)*stepSize);float f=field(p),alpha=1.-exp(-f*mix(.09,.055,uNear)*stepSize*(1.-focusRay*.55));float hue=volumeNoise(p*.1+vec3(5.,uTime*.006,3.));vec3 tint=mix(vec3(.22,.055,.48),vec3(.025,.53,.65),smoothstep(.4,.63,hue));float rim=pow(max(0.,1.-abs(f-.38)*3.2),5.);vec3 emission=tint*(1.25+rim*1.5)+vec3(.04,.16,.21)*pow(f,2.)*2.;light+=transmission*emission*alpha*(uGlow+uEnergy*.3);transmission*=1.-alpha;}
color=vec4(light,1.);}
