{
  "name": "astra-particle-desktop",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5181 --strictPort",
    "start": "npm run dev",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "test": "node --test tests/*.test.js",
    "build:android": "bash scripts/build-android.sh",
    "test:cleanup": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "dev:site": "vite --config vite.website.config.js",
    "build:site": "vite build --config vite.website.config.js",
    "preview:site": "vite preview --config vite.website.config.js --host 127.0.0.1 --port 4182"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "simple-icons": "16.35.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "8.3.5"
  },
  "description": "ASTRA 星穹：原生 Android TV 星云桌面与可恢复的系统维护工具",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheInitialDream1/astra-tv.git"
  },
  "homepage": "https://theinitialdream1.github.io/astra-tv/"
}
